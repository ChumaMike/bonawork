# Copy to .env.local and fill in. Never commit real values.
# Nothing here is required to run the app locally: without DATABASE_URL it uses
# an in-process store, and without a complete LEDGER_* set it uses an in-memory
# ledger that is clearly labelled "not a blockchain".

# --- Backend ------------------------------------------------------------------
# Postgres connection string (Neon via the Vercel Marketplace in production).
DATABASE_URL=
# Session signing secret, at least 32 characters.
AUTH_SECRET=
# Directory for private evidence files in local development (git-ignored).
EVIDENCE_STORAGE_DIR=.evidence
# Vercel Blob (private store) token for evidence in production.
BLOB_READ_WRITE_TOKEN=

# --- Ledger (Bona Chain contracts on Avalanche Fuji) ---------------------------
# auto = Avalanche when the values below are complete, else in-memory; memory; off
LEDGER_MODE=auto
# Avalanche Fuji C-Chain JSON-RPC endpoint.
LEDGER_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# CAIP-2 chain id. Only Fuji (eip155:43113) is accepted; mainnet is refused.
LEDGER_CHAIN_ID=eip155:43113
# Deployed BonaChainFactory address. When set, the app writes to the
# InstitutionOperations and InstitutionFinance contracts that this factory
# created for each institution, and LEDGER_CONTRACT_ADDRESS is ignored.
LEDGER_FACTORY_ADDRESS=
# The earlier single BonaRegistry (contracts/deployments/43113.json). Used only
# when LEDGER_FACTORY_ADDRESS is empty. Never written to once a factory is set.
LEDGER_CONTRACT_ADDRESS=
# Seven DIFFERENT server-side testnet keys, one per on-chain role. The role that
# signs is fixed by the operation, never by the request. Never NEXT_PUBLIC_.
# The app refuses to start if any two are the same.
# Report flow (needed with either address above):
LEDGER_REGISTRAR_PRIVATE_KEY=
LEDGER_SCHOOL_ADMIN_PRIVATE_KEY=
LEDGER_REVIEWER_PRIVATE_KEY=
# Procurement trail (Bona Chain only). Each must hold its role on the factory:
# Buyer, Supplier, Receiver, PaymentApprover.
LEDGER_BUYER_PRIVATE_KEY=
LEDGER_SUPPLIER_PRIVATE_KEY=
LEDGER_RECEIVER_PRIVATE_KEY=
LEDGER_PAYMENT_APPROVER_PRIVATE_KEY=
# auto = finance steps are written to the ledger when the factory and all seven
# keys are set. off = finance steps stay in the database only, and the app
# labels them as not anchored.
LEDGER_FINANCE_MODE=auto

# --- Bona AI --------------------------------------------------------------------
# Vercel AI Gateway key. When absent, Bona AI falls back to keyword search and
# the manual reporting path; nothing else changes.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5-5

# --- Backend (added with the API build) ---------------------------------------
# PGlite data directory used when DATABASE_URL is unset ("memory" = ephemeral).
PGLITE_DATA_DIR=.data/pglite
# Password of every seeded demo account (docs/demo/DEMO_SCENARIO.md §3).
# Default when unset: bona-demo-2026
DEMO_ACCOUNT_PASSWORD=
# Shared secret for POST /api/ledger/retry (header x-cron-secret or the bearer
# token Vercel cron sends) and POST /api/demo/reset.
CRON_SECRET=
# Set to "true" to enable POST /api/demo/reset (truncates and re-seeds, re-anchoring on the ledger).
DEMO_RESET_ENABLED=

# --- Frontend data source -------------------------------------------------------
# "live" makes the screens call the HTTP API (/api/*) with cookie sessions.
# Anything else keeps the browser fixtures (sample data, no backend).
NEXT_PUBLIC_API_SOURCE=live

# --- Price check -------------------------------------------------------------------
# Firecrawl API key for the invoice price check (search of SA hardware shops).
# Without it every line is "unavailable" and nothing is blocked.
FIRECRAWL_API_KEY=

# --- BonaWork on Solana devnet ---------------------------------------------------
# Public addresses (program, BDZAR mint, role keys) are in config/solana-devnet.json.
# Solana JSON-RPC endpoint. Default: https://api.devnet.solana.com (rate limited).
SOLANA_RPC_URL=
# Server-side keys, one per role, base58 or a JSON array of 64 bytes. Never NEXT_PUBLIC_.
BONAWORK_ADMIN_KEY=
BONAWORK_MATCH_KEY=
BONAWORK_DISPUTE_KEY=
BONAWORK_FEEPAYER_KEY=
# Mint authority of the sandbox demo rand (BDZAR). No real money.
BONAWORK_TREASURY_KEY=
# Escrow Watchdog: releases and refunds when the program's rules allow.
BONAWORK_KEEPER_KEY=
# DEMO ONLY: signs claims for the demo contractor until contractors use their own wallets.
BONAWORK_DEMO_CONTRACTOR_KEY=
# DEMO ONLY: the funder behind "Fund this repair" until funders use their own wallets.
BONAWORK_DEMO_FUNDER_KEY=
# DEMO ONLY: the reviewer key the verify screen signs with ("Demo reviewer key (devnet)").
BONAWORK_DEMO_REVIEWER_KEY=
# DEMO ONLY: the supplier that Check 1 (materials on site) can be released to.
# In local development the key file is created on first use.
BONAWORK_DEMO_SUPPLIER_KEY=
# DEMO ONLY: the school written into new escrows; co-signs a reviewer change
# with the admin key. Without it, escrows name a keyless stand-in school.
BONAWORK_DEMO_SCHOOL_KEY=
# Optional: a registered reviewer wallet to name in new escrows instead of the demo reviewer.
BONAWORK_REVIEWER_ADDRESS=
# Local development only (ignored in production and on Vercel): folder of
# keypair files used for any key variable above that is unset. Keep it outside the repo.
BONAWORK_KEYS_DIR=

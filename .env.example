# Copy to .env.local and fill in. Never commit real values.
# Nothing here is required to run the app locally: without DATABASE_URL it uses
# an in-process store, and without a complete LEDGER_* set it uses an in-memory
# ledger that is clearly labelled "not a blockchain".

# --- Backend ------------------------------------------------------------------
# Postgres connection string (Neon via the Vercel Marketplace in production).
DATABASE_URL=
# Session signing secret, at least 32 characters.
AUTH_SECRET=
# Directory for private evidence files in local development (git-ignored).
EVIDENCE_STORAGE_DIR=.evidence
# Vercel Blob (private store) token for evidence in production.
BLOB_READ_WRITE_TOKEN=

# --- Ledger (BonaRegistry on Avalanche Fuji) — see docs/coordination/DEPENDENCIES.md D4
# auto = Avalanche when every LEDGER_* value below is set, else in-memory; memory; off
LEDGER_MODE=auto
# Avalanche Fuji C-Chain JSON-RPC endpoint.
LEDGER_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# CAIP-2 chain id. Only Fuji (eip155:43113) is accepted; mainnet is refused.
LEDGER_CHAIN_ID=eip155:43113
# Deployed BonaRegistry address (contracts/deployments/43113.json).
LEDGER_CONTRACT_ADDRESS=
# Three DIFFERENT server-side testnet keys, one per on-chain role. The role that
# signs is fixed by the operation, never by the request. Never NEXT_PUBLIC_.
LEDGER_REGISTRAR_PRIVATE_KEY=
LEDGER_SCHOOL_ADMIN_PRIVATE_KEY=
LEDGER_REVIEWER_PRIVATE_KEY=

# --- Bona AI --------------------------------------------------------------------
# Vercel AI Gateway key. When absent, Bona AI falls back to keyword search and
# the manual reporting path; nothing else changes.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5-5

# --- Backend (added with the API build) ---------------------------------------
# PGlite data directory used when DATABASE_URL is unset ("memory" = ephemeral).
PGLITE_DATA_DIR=.data/pglite
# Password of every seeded demo account (docs/demo/DEMO_SCENARIO.md §3).
# Default when unset: bona-demo-2026
DEMO_ACCOUNT_PASSWORD=
# Shared secret for POST /api/ledger/retry (header x-cron-secret or the bearer
# token Vercel cron sends) and POST /api/demo/reset.
CRON_SECRET=
# Set to "true" to enable POST /api/demo/reset (truncates and re-seeds, re-anchoring on the ledger).
DEMO_RESET_ENABLED=

# --- Frontend data source -------------------------------------------------------
# "live" makes the screens call the HTTP API (/api/*) with cookie sessions.
# Anything else keeps the browser fixtures (sample data, no backend).
NEXT_PUBLIC_API_SOURCE=live

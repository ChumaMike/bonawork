/**
 * Turns pictures dropped into public/images/raw/ into sized WebP and JPEG
 * variants under public/images/, and rewrites src/components/media/generated.ts
 * so <Photo> knows each file, its size and its dominant colour.
 *
 *   pnpm images              # optimise every raw file whose name is a manifest key
 *   pnpm images hero_home    # just one
 *
 * The raw file's base name must be a key from manifest.ts (hero_home.jpg,
 * category_water.png, …). Raw files are never committed; the outputs are.
 * Documented in docs/design/IMAGES.md. Runs on Node 22.6+ (type stripping).
 */
import { mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { basename, dirname, extname, join } from "node:path";
import { fileURLToPath } from "node:url";
import sharp from "sharp";

const here = dirname(fileURLToPath(import.meta.url));
const root = join(here, "../..");
const rawDir = join(root, "public/images/raw");
const outDir = join(root, "public/images");
const manifestPath = join(root, "src/components/media/manifest.ts");
const generatedPath = join(root, "src/components/media/generated.ts");

/** Widths of the WebP variants. The JPEG is written at the largest. */
const WIDTHS = [480, 960, 1600];
const MAX_WIDTH = WIDTHS[WIDTHS.length - 1];
const INPUT_TYPES = new Set([".jpg", ".jpeg", ".png", ".webp", ".avif", ".tif", ".tiff"]);

type Generated = {
  file: string;
  width: number;
  height: number;
  color: string;
  variants: number[];
};

function manifestKeys(): Set<string> {
  const source = readFileSync(manifestPath, "utf8");
  const block = source.match(/PHOTO_NAMES = \[([\s\S]*?)\] as const/);
  if (!block) throw new Error("Could not read PHOTO_NAMES from manifest.ts");
  return new Set(Array.from(block[1].matchAll(/"([a-z_]+)"/g), (m) => m[1]));
}

function existingGenerated(): Record<string, Generated> {
  const source = readFileSync(generatedPath, "utf8");
  // The constant, not the "AUTO-GENERATED" comment or the type above it.
  const block = source.match(/export const GENERATED[^=]*=\s*(\{[\s\S]*\});/);
  if (!block) return {};
  try {
    // The file is plain JSON-compatible object literal apart from the keys.
    return JSON.parse(
      block[1].replace(/(\w+):/g, '"$1":').replace(/,\s*}/g, "}"),
    ) as Record<string, Generated>;
  } catch (cause) {
    // Carrying on would rewrite the file without the pictures already in it.
    throw new Error(`Could not read the entries in ${generatedPath}`, { cause });
  }
}

function toHex({ r, g, b }: { r: number; g: number; b: number }): string {
  return "#" + [r, g, b].map((v) => Math.round(v).toString(16).padStart(2, "0")).join("");
}

async function optimise(key: string, input: string): Promise<Generated> {
  const image = sharp(input, { failOn: "none" }).rotate();
  const meta = await image.metadata();
  const sourceWidth = meta.width ?? MAX_WIDTH;
  const { dominant } = await image.clone().stats();

  // One WebP per step up to the source width; a smaller source ends with a
  // variant at its own width so the largest file is never an enlargement.
  const steps = [...new Set(WIDTHS.map((width) => Math.min(width, sourceWidth)))];
  const variants: number[] = [];
  for (const width of steps) {
    await image
      .clone()
      .resize({ width, withoutEnlargement: true })
      .webp({ quality: 78, effort: 5 })
      .toFile(join(outDir, `${key}-${width}.webp`));
    variants.push(width);
  }

  const jpeg = await image
    .clone()
    .resize({ width: MAX_WIDTH, withoutEnlargement: true })
    .jpeg({ quality: 82, mozjpeg: true, progressive: true })
    .toFile(join(outDir, `${key}.jpg`));

  return {
    file: `/images/${key}.jpg`,
    width: jpeg.width,
    height: jpeg.height,
    color: toHex(dominant),
    variants,
  };
}

function writeGenerated(entries: Record<string, Generated>) {
  const keys = Object.keys(entries).sort();
  const body = keys
    .map((key) => {
      const e = entries[key];
      return `  ${key}: {\n    file: "${e.file}",\n    width: ${e.width},\n    height: ${e.height},\n    color: "${e.color}",\n    variants: [${e.variants.join(", ")}],\n  },`;
    })
    .join("\n");
  const source = `/* AUTO-GENERATED by scripts/images/optimise.mts — do not edit by hand.
 * One entry per key in manifest.ts whose source file has been optimised.
 * \`file\` is served from public/, so the path starts with /images/. */
export type GeneratedPhoto = {
  file: string;
  width: number;
  height: number;
  /** Dominant colour, shown while the picture loads. */
  color: string;
  /** Widths of the WebP variants written next to the file. */
  variants: number[];
};

export const GENERATED: Partial<Record<string, GeneratedPhoto>> = {${keys.length ? `\n${body}\n` : ""}};
`;
  writeFileSync(generatedPath, source);
}

async function main() {
  mkdirSync(rawDir, { recursive: true });
  mkdirSync(outDir, { recursive: true });
  const keys = manifestKeys();
  const only = new Set(process.argv.slice(2));
  const entries = existingGenerated();

  const files = readdirSync(rawDir).filter((name) =>
    INPUT_TYPES.has(extname(name).toLowerCase()),
  );
  if (files.length === 0) {
    console.log(
      `Nothing in ${rawDir}. Drop hero_home.jpg, category_water.jpg, … there first.`,
    );
    return;
  }

  let done = 0;
  for (const name of files) {
    const key = basename(name, extname(name)).toLowerCase();
    if (only.size && !only.has(key)) continue;
    if (!keys.has(key)) {
      console.warn(`skip  ${name}: "${key}" is not a key in manifest.ts`);
      continue;
    }
    process.stdout.write(`image ${key} … `);
    entries[key] = await optimise(key, join(rawDir, name));
    console.log(`${entries[key].width}×${entries[key].height} ${entries[key].color}`);
    done++;
  }

  writeGenerated(entries);
  console.log(
    `\n${done} optimised; ${Object.keys(entries).length}/${keys.size} keys have files. Wrote ${generatedPath}`,
  );
  const missing = [...keys].filter((key) => !entries[key]);
  if (missing.length) console.log(`still placeholders: ${missing.join(", ")}`);
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});

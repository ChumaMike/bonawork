{
  "name": "bona",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:generate": "drizzle-kit generate --config database/drizzle.config.ts && node database/bundle-migrations.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && pnpm --filter bona-verify typecheck",
    "test": "vitest run && pnpm --filter bona-verify test",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "images": "node scripts/images/optimise.mts",
    "design:contrast": "node scripts/design/contrast.mts",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@vercel/blob": "^2.9.0",
    "ai": "^7.0.173",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0",
    "viem": "^2.57.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}

# Copy to contracts/.env (git-ignored). Development keys only — never a key holding real funds.

# Avalanche Fuji C-Chain (chain ID 43113)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Funded Fuji dev wallet that deploys the registry and becomes its owner.
FUJI_DEPLOYER_PRIVATE_KEY=

# --- scripts/grant-roles.ts -------------------------------------------------
# Preferred: the institution UUID from the app database (or a 0x bytes32).
# A UUID is left-padded with zeros to bytes32 and must match the app's idToBytes32.
BONA_SCHOOL_ID=
# Fallback when BONA_SCHOOL_ID is empty: schoolId = keccak256(utf8(label)).
BONA_SCHOOL_LABEL=bona:school:demo-001

# --- scripts/setup-fuji.ts (all schools at once) -----------------------------
# Comma-separated institution UUIDs. Demo school plus the four other seed schools:
BONA_SCHOOL_IDS=00000000-0000-4000-8000-010000000001,00000000-0000-4000-8000-010000000002,00000000-0000-4000-8000-010000000003,00000000-0000-4000-8000-010000000004,00000000-0000-4000-8000-010000000005

# --- scripts/fund-roles.ts ---------------------------------------------------
# Gas top-up per role address, sent from the deployer. Default 0.05, maximum 1.
BONA_ROLE_TARGET_AVAX=0.05

# --- scripts/anchor-check.ts -------------------------------------------------
# Transaction to decode (read-only, needs no key). Usually passed inline.
BONA_TX_HASH=

# ADDRESSES only. Each must be a different key, held by a different party:
#   registrar    -> backend relayer that anchors reports
#   school admin -> school administration signing key
#   reviewer     -> independent reviewer signing key (must NOT be the school admin)
BONA_REGISTRAR_ADDRESS=
BONA_SCHOOL_ADMIN_ADDRESS=
BONA_REVIEWER_ADDRESS=

# === Bona Chain suite (scripts/chain/*) ======================================
# The factory holds seven roles per institution. Registrar, school admin and reviewer are
# the three addresses above. The four finance addresses come from `pnpm chain:keys`, which
# writes them (with their testnet keys) to the git-ignored contracts/.env.finance.local.
# setup and fund read the ADDRESS lines of that file by themselves, so the four lines
# below only need a value if you want to override it. ADDRESSES only, never keys.
BONA_BUYER_ADDRESS=
BONA_SUPPLIER_ADDRESS=
BONA_RECEIVER_ADDRESS=
BONA_PAYMENT_APPROVER_ADDRESS=

# --- scripts/chain/setup.ts ---------------------------------------------------
# Comma-separated institution UUIDs. Empty means the five seed institutions (the same five
# ids as BONA_SCHOOL_IDS above).
BONA_INSTITUTION_IDS=
# The setup aborts before sending anything if its estimated cost is above this. Default 0.5.
BONA_SETUP_MAX_AVAX=0.5
# Only to point setup at a factory other than the one in deployments/bonachain.<chainId>.json.
BONA_FACTORY_ADDRESS=

# --- scripts/chain/fund.ts ----------------------------------------------------
# Gas top-up per finance address, sent from the deployer. Default 0.02, maximum 0.5.
BONA_FINANCE_TARGET_AVAX=0.02

# --- scripts/chain/deploy.ts --------------------------------------------------
# Set to 1 only to deploy a second factory on Fuji on purpose (the first is then orphaned).
BONA_REDEPLOY=

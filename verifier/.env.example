# BonaBlock Verify reads Avalanche through its OWN RPC. It never calls the BonaBlock app.
# Public Fuji C-Chain RPC (default). Any Fuji RPC works — pick one you trust.
VERIFY_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Numeric chain id. Receipts must name eip155:<this id>.
VERIFY_CHAIN_ID=43113
# Optional. When set, receipts naming any other contract are rejected.
# BonaRegistry is deployed on Avalanche Fuji (chain 43113) at the address below.
# Production sets this, so only that contract's receipts are accepted.
# VERIFY_CONTRACT_ADDRESS=0xa8BB5Dc1c031d850AB32768Ed020e9aA604e1aae
